# Copy to .env for `vercel dev`, and add the same keys in Vercel -> Project -> Settings -> Environment Variables.
# These are SERVER-ONLY secrets (no VITE_ prefix) so they are never shipped to the browser.

# --- Supabase (stores inquiries) -------------------------------------------
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...   # "service_role" key, NOT the anon key

# --- Resend (emails you each inquiry) --------------------------------------
# resend.com -> API Keys
RESEND_API_KEY=re_xxxxxxxxxxxx
INQUIRY_TO_EMAIL=eximsnenterprises@gmail.com        # comma-separate for multiple recipients
# Optional. Default sender works without domain setup but only delivers to the Resend account owner's email.
# Verify your domain in Resend, then use e.g. "SN Global Tech <inquiries@snglobaltech.com>"
# INQUIRY_FROM_EMAIL=
